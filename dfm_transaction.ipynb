        "run_input = {\n",
        "    \"startUrls\": [\n",
        "        { \"url\": \"https://www.facebook.com/groups/DubaiPropertyInvestors/\" },\n",
        "        { \"url\": \"https://www.facebook.com/groups/2485536551677335/\" }\n",
        "    ],\n",
        "    \"maxPosts\": 40,\n",
        "    # This is an objective geographical filter\n",
        "    \"searchTerm\": districts_to_track,\n",
        "    \"viewOption\": \"CHRONOLOGICAL\"\n",
